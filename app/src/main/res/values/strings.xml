    <string-array name="scoring_examples">
        <item>K=strikeout (backward K=called 3<sup>rd</sup> strike)</item>
        <item>W/BB=walk, (IW=intentional walk)</item>
        <item>7=flyout to left</item>
        <item>7F=flyout to left foul ball</item>
        <item><u>6</u>=lineout to shortstop</item>
        <item>3U=groundout to 1<sup>st</sup> base unassisted</item>
